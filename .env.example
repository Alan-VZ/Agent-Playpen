# .env.example — Complete Environment File
# =================================================================
# Agent Playpen — Environment Variables
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.
# =================================================================

# ----------------------------------------------------------------
# BACKEND SETTINGS
# ----------------------------------------------------------------

# Default backend to use when --backend flag is not specified
DEFAULT_BACKEND=lm_studio

# LM Studio (local inference — no API key required)
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model
LM_STUDIO_TEMPERATURE=0.7
LM_STUDIO_MAX_TOKENS=2048

# OpenAI (cloud)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_ORG_ID=org-...

# Anthropic Claude (cloud)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Groq (cloud, very fast inference)
GROQ_API_KEY=gsk_...

# Together AI (cloud, many open models)
TOGETHER_API_KEY=...
TOGETHER_MODEL=meta-llama/Llama-3-70b-chat-hf

# Azure OpenAI (enterprise cloud)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=...
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# ----------------------------------------------------------------
# MEMORY SETTINGS
# ----------------------------------------------------------------

# Vector store provider: chroma (default) or faiss
MEMORY_VECTOR_PROVIDER=chroma

# Sentence-transformers model for local embeddings
MEMORY_EMBED_MODEL=all-MiniLM-L6-v2

# Directory where ChromaDB persists its data
CHROMA_PERSIST_DIR=./chroma_data

# Max tokens to keep in the conversation buffer
MAX_CONVERSATION_TOKENS=4000

# Comma-separated list of enabled memory stores
MEMORY_ENABLED_STORES=working,conversation

# ----------------------------------------------------------------
# TOOL SETTINGS
# ----------------------------------------------------------------

# Comma-separated list of enabled tool names
TOOLS_ENABLED=web_search,fetch,read_file,write_file,calculator

# Seconds before a tool call is aborted with TimeoutError
TOOL_TIMEOUT_SECONDS=30

# Comma-separated forbidden import patterns for PythonReplTool
PYTHON_REPL_FORBIDDEN_IMPORTS=os.system,subprocess,__import__,eval,exec

# Comma-separated list of directories the filesystem tools may access
ALLOWED_DIRS=.

# Web search provider: auto, duckduckgo (no key), serpapi, tavily, or google
WEB_SEARCH_PROVIDER=auto
SERPAPI_API_KEY=
TAVILY_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ----------------------------------------------------------------
# DEBUG SETTINGS
# ----------------------------------------------------------------

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log output format: console (coloured) or json (structured)
LOG_FORMAT=console

# Directory where trace JSON files are saved
TRACE_DIR=./traces

# Set to false to disable token cost tracking
COST_TRACKING_ENABLED=true

# Port for the debug dashboard server
DASHBOARD_PORT=8765
