{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Agent Playpen: Local Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "debugging.dashboard.server",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Uvicorn running on (https?://[^\\s]+)",
                "uriFormat": "%s"
            }
        }
    ]
}
